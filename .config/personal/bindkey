#!/usr/bin/env zsh

# Standard and additional keybindings
# https://github.com/tomsquest/dotfiles/blob/master/zsh/bindkey.zsh
# Find the key with: showkey -a
#
#   ctrl + u     : clear line
#   ctrl + w     : delete word backward
#   alt  + d     : delete word
#   ctrl + a     : move to beginning of line
#   ctrl + e     : move to end of line (e for end)
#   alt/ctrl + f : move to next word (f for forward)
#   alt/ctrl + b : move to previous word (b for backward)
#   ctrl + d     : delete char at current position (d for delete)
#   ctrl + k     : delete from character to end of line
#   alt  + .     : cycle through previous args

# ctrl+left/right: move word by word (backward/forward)
# bindkey '^[[D' backward-word
# bindkey '^[[C' forward-word

# Search history with arrow keys 
bindkey '^[[A' history-search-backward 
bindkey '^[[B' history-search-forward

# ctrl+backspace: delete word before
bindkey '^H' backward-kill-word
# ctrl+delete: delete word after
bindkey "\e[3;5~" kill-word

bindkey -s ^f "tmux-sessionizer\n"

function noop() {}
zle -N noop
# Unbind ^G
bindkey '^G' noop

function lazygit-widget() { lazygit }
zle -N lazygit-widget
bindkey '^G^G' lazygit-widget
bindkey '^Gg' lazygit-widget

# FZF into nvim, do I want to change this bind?
bindkey -s '^o' 'nvim $(fzf)^M'
